# =========================================================
# iStoreOS 24.10 x86_64 PVE 旁路由 diffconfig（v1.2）
# 底包：istoreos/istoreos 分支 istoreos-24.10
# 说明：iStoreOS 默认自带 LuCI/中文/istore 商店，无需重复选
# =========================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ---------- PVE 客户机代理（virtio 驱动 x86_64 内核已内建，无需 kmod） ----------
CONFIG_PACKAGE_qemu-ga=y

# ---------- 镜像：EFI + legacy 双格式，3GB 根分区 ----------
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_PARTSIZE=3072

# ---------- SSL 后端：只留 openssl 变体，防止双 ustream 抢 libustream-ssl.so ----------
# （ImmortalWrt 项目实测：mbedtls+openssl 同时选中会 opkg file clashes / Error 255）
# CONFIG_PACKAGE_libustream-mbedtls is not set
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_luci-ssl-openssl=y

# ---------- dnsmasq 单变体：只留 dnsmasq-full ----------
# iStoreOS 默认包列表同时带 dnsmasq（基础系统）和 dnsmasq-full（istore 生态），
# 不显式关掉 dnsmasq 会在 rootfs 打包阶段 file clashes / package/install Error 255
#（v1.1 首次编译实测踩中）。OpenClash 的 ipset/nftset 分流也需要 full 版。
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# ---------- 基础工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_htop=y

# ---------- 透明代理公共依赖 ----------
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_yq=y

# ---------- OpenClash（Meta/mihomo 内核随固件内置，见 workflow 烘焙步骤） ----------
CONFIG_PACKAGE_luci-app-openclash=y
# openclash 依赖 ruby；ruby 的 YJIT 在 x86_64 默认开启且需源码编译整套 rust
# 工具链（GitHub runner 实测 2 小时后失败）。ruby 仅用于订阅解析，必须关掉：
# CONFIG_RUBY_ENABLE_YJIT is not set

# ---------- 关闭 Docker（旁路由不需要，编译提速约 20~30 分钟；istore 商店不依赖它） ----------
# 如需 Docker 删除以下 5 行即可
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_docker-compose is not set
# CONFIG_PACKAGE_containerd is not set
# CONFIG_PACKAGE_runc is not set
